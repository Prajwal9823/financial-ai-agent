# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — NEVER commit real API keys.

# Required: Gemini API key for the LLM synthesis step
GEMINI_API_KEY=

# Gemini model used for research response generation
LLM_MODEL=gemini-3.6-flash

# Optional: only needed if you swap market/fundamental data
# to Alpha Vantage
ALPHA_VANTAGE_API_KEY=

# SEC EDGAR requires a descriptive User-Agent.
# Replace the email with your own email address.
SEC_USER_AGENT=FinancialAIAgent research-project your_email@example.com

# Cache lifetime, in seconds
CACHE_TTL_SECONDS=900

# Maximum number of news articles fetched/scored per ticker
MAX_NEWS_ARTICLES=10

# Frontend URL used for CORS
FRONTEND_ORIGIN=http://localhost:3000